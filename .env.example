# Copy to `.env` and restart `npm run dev`.
# Chat uses backend POST /chat (Vite proxies /chat → http://127.0.0.1:8000).
# Set GEMINI_API_KEY in backend/apps/.env and run: python run_api.py

# Optional: backend base URL without trailing slash (default: same origin /chat)
# VITE_API_BASE=http://127.0.0.1:8000

# 날씨는 백엔드 GET /weather 사용 → 키는 backend/apps/.env 의 OPENWEATHER_API_KEY
# (호환) VITE_OPENWEATHER_API_KEY 도 backend 에서 읽습니다.
